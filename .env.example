DATABASE_URL=fill-it-in

# Auth (self-hosted better-auth). SECRET_KEY signs the session cookie and
# emailed links — required in production, must be at least 32 characters.
# Generate one with:
#   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SECRET_KEY=fill-it-in

# Public origin of the app — emailed verification/reset links use it
# (defaults to http://localhost:3000)
# BASE_URL=https://your-app.fly.dev

# Extra origins allowed to call the API, comma-separated. The Vite dev
# server origin is added automatically outside production.
# TRUSTED_ORIGINS=

# Allow public sign-up from the /sign-up page
ALLOW_PUBLIC_REGISTRATION=true

# Block sign-in until the email is verified (default: off — unverified users
# can sign in but see a verification banner)
# REQUIRE_EMAIL_VERIFICATION=true

# CIDR allowlist of trusted reverse proxies (empty = never trust X-Forwarded-For)
# e.g. TRUST_PROXY=10.0.0.0/8,::1/128
TRUST_PROXY=

# Cookies: secure defaults to true in production, false in development
# COOKIE_SECURE=true

# memory (single instance) | postgres (multi-instance). Drives both the
# general API limiter and better-auth's auth-endpoint rate limiting.
RATE_LIMIT_BACKEND=memory

# Email: "dev" captures mail instead of delivering it (no SMTP needed locally).
# Real delivery transports are added when a vendor is chosen.
EMAIL_TRANSPORT=dev

# PORT=3000
